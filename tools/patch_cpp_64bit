#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""
Applies the 64-bit changes to the translated game in src/Cpp/NFS2SE.cpp.

src/Cpp is a submodule pointing at upstream NFSIISE-CPP, so the changes live
here as a patch script rather than as edits in this repository's history. It is
idempotent: running it twice is harmless, and `--check` only reports.

There are exactly three changes, which is the whole point -- see LowMem.h for
why so little is needed.

  1. The __WORDSIZE guard, which hard-errors on anything but a 32-bit build.
  2. push32's size assertion. A handful of call sites push a real pointer,
     which is 4 bytes on a 32-bit build and 8 on a 64-bit one.
  3. The only two allocations in 249k lines -- the CPU's simulated stack and
     the Game context -- which must come from below 2 GiB.

Everything else survives untouched: the ~2286 pointer-to-int32 truncations the
compiler complains about are exactly the ones that are correct provided every
address the game can see fits in 32 bits, which is what LowMem and -no-pie
between them guarantee.
"""

import sys
import os
import re

CPP = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src", "Cpp", "NFS2SE.cpp")

CHANGES = [
    (
        "WORDSIZE guard",
        '''#if !defined(__WORDSIZE) || (__WORDSIZE != 32)
\t#error "This game is compatible only with 32-bit CPUs!"
#endif''',
        '''#if !defined(__WORDSIZE)
\t#error "__WORDSIZE is not defined!"
#endif
#if (__WORDSIZE != 32)
/*
 * 64-bit build. The game stores real addresses in int32_t slots, so this is
 * only sound while every address it can observe fits in 32 bits. That is what
 * -no-pie (code and static data low) and LowMem.h (everything heap-allocated
 * low) exist to guarantee. Build with -fpermissive: the truncations the
 * compiler flags are the intended ones.
 */
extern "C" void *lowMemAlloc(unsigned long size);
extern "C" void lowMemFree(void *ptr);
#else
#define lowMemAlloc malloc
#define lowMemFree free
#endif

/*
 * An address stored in the game's static data. The game indexes its pointer
 * tables at a 4-byte stride (`to32i(off_421560 + eax * 4)`), so these fields
 * must stay 4 bytes wide no matter what the host's pointer size is -- widening
 * them would both break that indexing and shift the layout of everything after
 * them in _data. NFS_GA truncates in the static initialisers, which the linker
 * resolves as ordinary 32-bit relocations because the build is -no-pie and all
 * of _data sits below 2 GiB.
 *
 * On a 32-bit build this is exactly what void * already was, so it changes
 * nothing there.
 */
typedef uint32_t GameAddr32;
#define NFS_GA(p) ((GameAddr32)(uintptr_t)(p))

/*
 * A function, as the game stores one. Code cannot be addressed by an offset
 * into the arena, so referenced functions get an index into a generated
 * dispatch table instead, tagged in the top nibble so that a call site can
 * tell it apart from a data offset. See tools/patch_cpp_64bit.
 */
#define NFS_FN_TAG  0xF0000000u
#define NFS_FN(idx) ((GameAddr32)(NFS_FN_TAG | (idx)))
extern void (*const g_nfsFuncTable[])(void *);
extern const uint32_t g_nfsFuncCount;
/* Defined far below, but call() needs it up here. */
extern "C" void nfsCallGameFunction(uint32_t id, void *gameContext);
extern "C" uint32_t nfsRegisterFunction(void (*fn)(void *));

#include <cstdio>
static inline void nfsBadCall(uint32_t target)
{
	/*
	 * Fail loudly. Before the table existed this would have jumped to whatever
	 * the value happened to address, which is how a mistake here used to
	 * present as corruption three subsystems away.
	 */
	fprintf(stderr, "NFS: indirect call through %#x, which is not a function index\\n", target);
	abort();
}''',
    ),
    (
        "push32 size assertion",
        '''\ttemplate<typename T>
\tFnInl(void) push32(const T val)
\t{
\t\tASSERT_SIZE(4, val);
\t\tesp -= 4;
\t\tto32i(esp) = (int32_t)val;
\t}''',
        '''\ttemplate<typename T>
\tFnInl(void) push32(const T val)
\t{
\t\t/*
\t\t * A few call sites push a real pointer rather than a 4-byte value, which
\t\t * only matches this assertion on a 32-bit build. Truncate explicitly
\t\t * instead; it is lossless because the address is below 2 GiB.
\t\t */
\t\tstatic_assert(sizeof(val) == 4 || is_pointer<T>::value,
\t\t\t"push32 takes a 4-byte value or a pointer");
\t\tesp -= 4;
\t\tto32i(esp) = (int32_t)(intptr_t)val;
\t}''',
    ),
    (
        "CPU stack allocation",
        "\t\tstack = (uint8_t *)malloc(stack_size);",
        "\t\tstack = (uint8_t *)lowMemAlloc(stack_size);",
    ),
    (
        "CPU stack release",
        "\t\tfree(stack);",
        "\t\tlowMemFree(stack);",
    ),
    (
        "Game context allocation",
        "\tGame *new_game_ctx = (Game *)malloc(sizeof(Game));",
        "\tGame *new_game_ctx = (Game *)lowMemAlloc(sizeof(Game));",
    ),
    (
        "indirect call dispatch",
        '''	template<typename T>
	FnInl(void) call(const T addr)
	{
		esp -= 4;
		((void(*)(void *))addr)(this);
		esp += 4;
	}''',
        '''	template<typename T>
	FnInl(void) call(const T addr)
	{
		/*
		 * The game calls through values it keeps in 32-bit slots. Those are
		 * no longer addresses -- code lives outside the arena -- so they are
		 * tagged indices into a generated table. An untagged value here means
		 * the game is trying to call data, which is a bug worth failing on
		 * rather than jumping into whatever it points at.
		 */
		const uint32_t target = (uint32_t)(uintptr_t)addr;
		esp -= 4;
		if ((target & NFS_FN_TAG) == NFS_FN_TAG)
			nfsCallGameFunction(target, this);
		else
			nfsBadCall(target);
		esp += 4;
	}''',
    ),
    (
        "wrapper call-in helpers",
        r'''extern "C" void wrap_regparm2(Game &game, void (*func)(Game &), int32_t arg0, int32_t arg1)
{
	game.eax = arg0;
	game.edx = arg1;
	func(game);
}

extern "C" int32_t wrap_stdcall2_ret(Game &game, void (*func)(Game &), int32_t arg0, int32_t arg1)
{
	game.push32(arg1);
	game.push32(arg0);
	game.esp -= 4;
	func(game);
	game.esp += 4;
	return game.eax;
}
extern "C" void wrap_stdcall4(Game &game, void (*func)(Game &), int32_t arg0, int32_t arg1, int32_t arg2, int32_t arg3)
{
	game.push32(arg3);
	game.push32(arg2);
	game.push32(arg1);
	game.push32(arg0);
	game.esp -= 4;
	func(game);
	game.esp += 4;
}''',
        r'''/*
 * Calling back into the game from the wrapper.
 *
 * The wrapper holds game functions as table indices rather than addresses --
 * see build_function_table -- so everything it calls in through resolves the
 * index here. nfsCallGameFunction is for the wrapper's own stored pointers
 * (thread start routines, the window proc, the audio callbacks); the wrap_*
 * helpers below are the ones the translated game's own thunks go through.
 */
/*
 * The wrapper's own thunks -- the COM vtable entries in DInput.c -- are not
 * visible to the generator, so they register at run time and take indices that
 * continue on from the generated table's.
 */
#define NFS_MAX_REGISTERED 64
static void (*g_nfsRegistered[NFS_MAX_REGISTERED])(void *);
static uint32_t g_nfsRegisteredCount;

extern "C" uint32_t nfsRegisterFunction(void (*fn)(void *))
{
	uint32_t i;
	if (!fn)
		return 0;
	/* Stable across repeated registration, so a vtable rebuilt after a device
	 * is recreated keeps the same indices. */
	for (i = 0; i < g_nfsRegisteredCount; ++i)
		if (g_nfsRegistered[i] == fn)
			return NFS_FN_TAG | (g_nfsFuncCount + i);
	if (g_nfsRegisteredCount >= NFS_MAX_REGISTERED)
	{
		fprintf(stderr, "NFS: too many registered wrapper functions\\n");
		abort();
	}
	g_nfsRegistered[g_nfsRegisteredCount] = fn;
	return NFS_FN_TAG | (g_nfsFuncCount + g_nfsRegisteredCount++);
}

static void (*nfsLookup(uint32_t index))(void *)
{
	if (index < g_nfsFuncCount)
		return g_nfsFuncTable[index];
	if (index - g_nfsFuncCount < g_nfsRegisteredCount)
		return g_nfsRegistered[index - g_nfsFuncCount];
	return 0;
}

extern "C" void nfsCallGameFunction(uint32_t id, void *gameContext)
{
	if ((id & NFS_FN_TAG) == NFS_FN_TAG)
	{
		void (*fn)(void *) = nfsLookup(id & ~NFS_FN_TAG);
		if (fn)
		{
			fn(gameContext);
			return;
		}
	}
	nfsBadCall(id);
}

static void (*nfsResolve(uint32_t id))(void *)
{
	if ((id & NFS_FN_TAG) == NFS_FN_TAG)
	{
		void (*fn)(void *) = nfsLookup(id & ~NFS_FN_TAG);
		if (fn)
			return fn;
	}
	nfsBadCall(id);
	return 0;
}

extern "C" void wrap_regparm2(Game &game, uint32_t func, int32_t arg0, int32_t arg1)
{
	game.eax = arg0;
	game.edx = arg1;
	nfsResolve(func)(&game);
}

extern "C" int32_t wrap_stdcall2_ret(Game &game, uint32_t func, int32_t arg0, int32_t arg1)
{
	game.push32(arg1);
	game.push32(arg0);
	game.esp -= 4;
	nfsResolve(func)(&game);
	game.esp += 4;
	return game.eax;
}
extern "C" void wrap_stdcall4(Game &game, uint32_t func, int32_t arg0, int32_t arg1, int32_t arg2, int32_t arg3)
{
	game.push32(arg3);
	game.push32(arg2);
	game.push32(arg1);
	game.push32(arg0);
	game.esp -= 4;
	nfsResolve(func)(&game);
	game.esp += 4;
}''',
    ),
    (
        "entry point Game contexts",
        '''extern "C" void nfs2seEntrypoint()
{
\tGame game, audio;
\tmain_game_thread = &game;
\taudio_game_thread = &audio;
\tgame._start();
}''',
        '''extern "C" void nfs2seEntrypoint()
{
\t/*
\t * These cannot be locals on a 64-bit build. The translation hands the
\t * context to the wrapper as `(int32_t)this` -- six call sites do it, e.g.
\t * DirectInputCreateA_wrap -- which is lossless when a pointer is 4 bytes
\t * and throws away the upper half when it is 8. The real thread stack lives
\t * around 0x7fff..., so a local arrives as a truncated address that faults
\t * the moment the wrapper calls back into the game through it.
\t *
\t * Allocating them below 2 GiB makes that truncation lossless again, which
\t * is the same bargain the rest of the port makes. Deliberately never freed:
\t * they live for the whole process and the game exits through exit().
\t */
\tGame *game = new (lowMemAlloc(sizeof(Game))) Game();
\tGame *audio = new (lowMemAlloc(sizeof(Game))) Game();
\tmain_game_thread = game;
\taudio_game_thread = audio;
\tgame->_start();
}''',
    ),
]


def build_function_table(source):
    """Replace code addresses with indices into a generated dispatch table.

    The game stores function addresses in 32-bit slots -- 295 sites take one
    directly, and 195 more sit in the static tables alongside data addresses.
    Under base+offset there is no address that can represent code, because the
    executable is not in the arena, so each referenced function gets an index
    instead and `call` dispatches through a table.

    The indices are tagged in their top nibble so a call site can tell a
    function from a data offset, and so that mistaking one for the other traps
    instead of jumping somewhere arbitrary.

    Ordering works out: the generated `static Fn(void) sub_X(Game *)`
    trampolines all sit in one block, before both the _data initialiser and
    every use, so the table can go straight after them.

    Returns (source, count).
    """
    # Three reference forms, and two name prefixes -- the generated code has
    # `nullsub_N` stubs alongside `sub_XXXX`. The leading \b keeps `sub_` from
    # matching inside `nullsub_`.
    FUNC = r'\b((?:null)?sub_[0-9A-Fa-f]+)\b'
    referenced = set()
    referenced.update(re.findall(r'\(int32_t\)' + FUNC, source))
    referenced.update(re.findall(r'NFS_GA\(' + FUNC + r'\)', source))
    referenced.update(re.findall(r'push32\(' + FUNC + r'\)', source))
    if not referenced:
        return source, 0

    ordered = sorted(referenced)
    index_of = {name: i for i, name in enumerate(ordered)}

    entries = "".join(f"\t(void (*)(void *))&{name},\n" for name in ordered)
    table = (
        "\n/* Generated by tools/patch_cpp_64bit -- see build_function_table. */\n"
        "void (*const g_nfsFuncTable[])(void *) = {\n"
        f"{entries}"
        "};\n"
        f"const uint32_t g_nfsFuncCount = {len(ordered)};\n"
    )

    # Straight after the last trampoline definition, whichever prefix it uses.
    last = None
    for m in re.finditer(r'^static Fn\(void\) (?:null)?sub_[0-9A-Fa-f]+\(Game \*self\).*$', source, re.M):
        last = m
    if last is None:
        raise RuntimeError("no trampoline definitions found")
    source = source[:last.end()] + "\n" + table + source[last.end():]

    # Rewrite both reference forms to the tagged index.
    def by_index(m):
        return f'NFS_FN({index_of[m.group(1)]})'
    source = re.sub(r'\(int32_t\)' + FUNC, by_index, source)
    source = re.sub(r'NFS_GA\(' + FUNC + r'\)', by_index, source)
    source = re.sub(r'push32\(' + FUNC + r'\)',
                    lambda m: f'push32(NFS_FN({index_of[m.group(1)]}))', source)

    return source, len(ordered)


# A generated field declaration inside the _data / _bss structs, e.g.
#   \tstruct packed {int32_t x00[4];void *x10[8];} off_409E10;
# The shapes vary a lot (146 pure pointer fields, the rest mixed with ints), so
# matching the line rather than each shape is what keeps this tractable.
FIELD_LINE = re.compile(r'^\s*struct packed \{.*\}\s*\w+;\s*$')

# The cast used throughout the _data initialiser: (void *)(dword_4E2718)
INIT_CAST = re.compile(r'\(void \*\)\(')


def convert_pointer_fields(source):
    """Narrow every pointer in the game's static data to 4 bytes.

    Two edits that have to agree with each other: the field declarations, and
    the initialiser that fills them in. Returns (source, fields, casts).
    """
    lines = source.split("\n")
    fields = 0

    for i, line in enumerate(lines):
        if "void *" in line and FIELD_LINE.match(line):
            lines[i] = line.replace("void *", "GameAddr32 ")
            fields += 1

    source = "\n".join(lines)

    source, casts = INIT_CAST.subn("NFS_GA(", source)

    # Null entries in those same tables are written as a bare `nullptr`, which
    # no longer converts now that the fields are an integer type. Scope this to
    # the _data initialiser so genuine pointer uses elsewhere are left alone.
    start = source.find("} static _data")
    if start != -1:
        end = source.find("\n};", start)
        if end != -1:
            block = source[start:end].replace("nullptr", "0")
            source = source[:start] + block + source[end:]

    return source, fields, casts


def main():
    check_only = "--check" in sys.argv

    if not os.path.exists(CPP):
        print("src/Cpp/NFS2SE.cpp not found. Run: git submodule update --init --recursive",
              file=sys.stderr)
        return 1

    with open(CPP, encoding="utf-8") as handle:
        source = handle.read()

    applied, already, missing = [], [], []

    for name, old, new in CHANGES:
        if new in source:
            already.append(name)
        elif old in source:
            source = source.replace(old, new, 1)
            applied.append(name)
        else:
            missing.append(name)

    for name in already:
        print(f"  already patched: {name}")
    for name in applied:
        print(f"  patched:         {name}")
    for name in missing:
        print(f"  NOT FOUND:       {name}", file=sys.stderr)

    if missing:
        print("\nsrc/Cpp/NFS2SE.cpp does not look like the expected revision.", file=sys.stderr)
        return 1

    # Ask the state of the file itself rather than looking for a marker string:
    # the WORDSIZE replacement above defines NFS_GA, so its presence says
    # nothing about whether the tables have been narrowed yet.
    source, fields, casts = convert_pointer_fields(source)
    if fields or casts:
        print(f"  patched:         static pointer tables ({fields} fields, {casts} initialisers)")
        applied.append("static pointer tables")
    else:
        print("  already patched: static pointer tables")

    # Must run after the tables are narrowed: it rewrites NFS_GA(sub_X), which
    # only exists once those initialisers have been converted.
    source, functions = build_function_table(source)
    if functions:
        print(f"  patched:         function dispatch table ({functions} functions)")
        applied.append("function dispatch table")
    else:
        print("  already patched: function dispatch table")

    if check_only:
        print("\nUp to date." if not applied else "\nWould apply the changes above.")
        return 0

    if applied:
        with open(CPP, "w", encoding="utf-8") as handle:
            handle.write(source)
        print("\nWrote src/Cpp/NFS2SE.cpp.")
    else:
        print("\nNothing to do.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
