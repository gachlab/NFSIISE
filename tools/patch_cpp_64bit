def build_function_table(source):
    """Replace code addresses with indices into a generated dispatch table.

    The game stores function addresses in 32-bit slots -- 295 sites take one
    directly, and 195 more sit in the static tables alongside data addresses.
    Under base+offset there is no address that can represent code, because the
    executable is not in the arena, so each referenced function gets an index
    instead and `call` dispatches through a table.

    The indices are tagged in their top nibble so a call site can tell a
    function from a data offset, and so that mistaking one for the other traps
    instead of jumping somewhere arbitrary.

    Ordering works out: the generated `static Fn(void) sub_X(Game *)`
    trampolines all sit in one block, before both the _data initialiser and
    every use, so the table can go straight after them.

    Returns (source, count).
    """
    # The trampolines are matched by name against the set the file actually
    # defines, not against a pattern. Guessing the shape of a generated name
    # has gone wrong three times here: `nullsub_N` sits alongside `sub_XXXX`,
    # and among 2502 trampolines are `doStart`, `bcopy_`, `strstr_` and other
    # readable names. `bcopy_` is referenced from a table of function pointers,
    # so a pattern that missed it left one entry as a truncated address that
    # the dispatcher would refuse to call.
    trampolines = set(re.findall(
        r'^static Fn\(void\) (\w+)\(Game \*self\)', source, re.M))
    if not trampolines:
        raise RuntimeError("no trampoline definitions found")

    referenced = set()
    for pattern in (r'\(int32_t\)(\w+)\b', r'NFS_GA\((\w+)\)', r'push32\((\w+)\)'):
        referenced.update(n for n in re.findall(pattern, source) if n in trampolines)
    if not referenced:
        return source, 0

    ordered = sorted(referenced)
    index_of = {name: i for i, name in enumerate(ordered)}

    entries = "".join(f"\t(void (*)(void *))&{name},\n" for name in ordered)
    table = (
        "\n/* Generated by tools/patch_cpp_64bit -- see build_function_table. */\n"
        "void (*const g_nfsFuncTable[])(void *) = {\n"
        f"{entries}"
        "};\n"
        f"const uint32_t g_nfsFuncCount = {len(ordered)};\n"
    )

    # Straight after the last trampoline definition, whichever prefix it uses.
    last = None
    for m in re.finditer(r'^static Fn\(void\) (?:null)?sub_[0-9A-Fa-f]+\(Game \*self\).*$', source, re.M):
        last = m
    if last is None:
        raise RuntimeError("no trampoline definitions found")
    source = source[:last.end()] + "\n" + table + source[last.end():]

    # Rewrite every reference form to the tagged index, leaving anything that
    # is not a trampoline alone -- `(int32_t)` in particular is all over the
    # generated code with ordinary values behind it.
    def by_index(m):
        name = m.group(1)
        return f'NFS_FN({index_of[name]})' if name in index_of else m.group(0)

    source = re.sub(r'\(int32_t\)(\w+)\b', by_index, source)
    source = re.sub(r'NFS_GA\((\w+)\)', by_index, source)
    source = re.sub(
        r'push32\((\w+)\)',
        lambda m: (f'push32(NFS_FN({index_of[m.group(1)]}))'
                   if m.group(1) in index_of else m.group(0)),
        source)

    return source, len(ordered)


# A generated field declaration inside the _data / _bss structs, e.g.
#   \tstruct packed {int32_t x00[4];void *x10[8];} off_409E10;
# The shapes vary a lot (146 pure pointer fields, the rest mixed with ints), so
# matching the line rather than each shape is what keeps this tractable.
FIELD_LINE = re.compile(r'^\s*struct packed \{.*\}\s*\w+;\s*$')

# The cast used throughout the _data initialiser: (void *)(dword_4E2718)
INIT_CAST = re.compile(r'\(void \*\)\(')


def convert_pointer_fields(source):
    """Narrow every pointer in the game's static data to 4 bytes.

    Two edits that have to agree with each other: the field declarations, and
    the initialiser that fills them in. Returns (source, fields, casts).
    """
    # build_arena moves this initialiser and renames its declaration, so on a
    # second run there is nothing here to find. Say so rather than failing:
    # the marker is the moved initialiser itself, not the presence of NFS_GA,
    # which the WORDSIZE replacement defines and would always match.
    if "static const NfsData nfsDataImage = {" in source:
        return source, 0, 0

    lines = source.split("\n")
    fields = 0

    for i, line in enumerate(lines):
        if "void *" in line and FIELD_LINE.match(line):
            lines[i] = line.replace("void *", "GameAddr32 ")
            fields += 1

    source = "\n".join(lines)

    # Both rewrites below are scoped to the _data initialiser, and the scoping
    # is not belt and braces. `(void *)(` and `nullptr` are ordinary C++ that
    # appears in this script's own replacements too, so rewriting the whole
    # file turns a pointer the wrapper needs at full width into a truncated
    # one -- silently, while the base is still zero, and fatally the moment it
    # is not.
    start = source.find("} static _data")
    end = source.find("\n};", start) if start != -1 else -1
    if start == -1 or end == -1:
        raise RuntimeError("could not find the _data initialiser to narrow")

    block = source[start:end]
    # Null entries in those same tables are written as a bare `nullptr`, which
    # no longer converts now that the fields are an integer type.
    block, casts = INIT_CAST.subn("NFS_GA(", block)
    block = block.replace("nullptr", "0")
    source = source[:start] + block + source[end:]

    return source, fields, casts


def build_arena(source):
    """Gather the game's static data into one object, so it can have a base.

    Under base+offset every address the game holds is an offset from one
    place, which means everything it can reach has to live in one place. This
    puts _data and _bss there. Nothing else changes yet: the macros still
    resolve to real addresses and the base is still zero, so this step is
    supposed to be invisible at run time -- which is exactly what makes it
    worth doing on its own.

    _data cannot simply move: it has an initialiser, and an arena big enough
    to hold the heap as well would then be emitted into the binary rather than
    left as demand-zero pages. So its initialiser becomes a separate image in
    .rodata, copied into the arena before the game starts.

    The image's own pointer fields are addresses of the arena copy, not of the
    image, because the macros they go through are redefined first. That is the
    point: the game must never see the image.

    Returns (source, applied).
    """
    if "struct packed NfsBss" in source:
        return source, False

    starts = [m.start() for m in re.finditer(r'^struct packed \{$', source, re.M)]
    if len(starts) != 2:
        raise RuntimeError(f"expected two anonymous static structs, found {len(starts)}")

    bss_end = "} static _bss alignas(4);"
    data_end = "} static _data alignas(4) = {"
    if bss_end not in source or data_end not in source:
        raise RuntimeError("could not find the _data / _bss declarations")

    # Name the two structs, so that offsetof can be taken on them later.
    source = source[:starts[1]] + source[starts[1]:].replace(
        "struct packed {", "struct packed NfsData {", 1)
    source = source[:starts[0]] + source[starts[0]:].replace(
        "struct packed {", "struct packed NfsBss {", 1)

    source = source.replace(bss_end, "};", 1)

    # The arena has to be declared, and _data/_bss redirected into it, before
    # the initialiser that follows -- the initialiser reaches its own fields
    # through those very macros.
    arena = '''};

/*
 * The game's world, in one object.
 *
 * Everything the game can address has to sit at a known offset from a single
 * base, because a 32-bit slot is about to stop holding an address and start
 * holding that offset. This is that single place. The heap joins it later;
 * for now it is the two blocks of static data, in the order the offsets will
 * assume.
 *
 * Deliberately uninitialised, so it costs address space rather than binary:
 * _data's initial contents are copied in by nfsArenaInit below.
 */
#define NFS_ARENA_HEAP_BYTES (192u * 1024u * 1024u)
struct NfsArena {
\t/*
\t * Nothing lives at offset zero. The game tests addresses against zero to
\t * mean "none", and it would be right about a thousand times and wrong
\t * about the field that happened to land first.
\t */
\talignas(16) unsigned char reserved[4096];
\talignas(16) NfsData data;
\talignas(16) NfsBss bss;
\talignas(16) unsigned char heap[NFS_ARENA_HEAP_BYTES];
};
static NfsArena nfsArena;

/*
 * The generated code says _data.x and _bss.x in several thousand places, and
 * every one of them should now mean the arena. Redirecting the two names is
 * cheaper and far less risky than rewriting the uses, and it keeps taking the
 * address of a field a constant expression -- which the handful of statics
 * exported to the wrapper at the end of this file depend on.
 */
#define _data (nfsArena.data)
#define _bss (nfsArena.bss)

/*
 * The base, and the whole point of the arena.
 *
 * A 32-bit slot in this file no longer holds an address; it holds a distance
 * from here. That is what lets the game run where the low 4 GiB cannot be
 * mapped at all, which is every arm64 Apple platform and Android.
 *
 * Defined here rather than in the wrapper so that the compiler can see it is
 * the address of a static object and fold the addition into the addressing
 * mode. It is const because the build is -fno-strict-aliasing: a mutable base
 * would have to be reloaded after every store the game makes, which measures
 * 28 instructions against 21 in the game's inner loops.
 */
extern "C" const uintptr_t g_nfsBase = (uintptr_t)&nfsArena;

/* The extent of the arena, so that the wrapper can check what it converts. */
extern "C" const unsigned long g_nfsArenaBytes = (unsigned long)sizeof nfsArena;

/* The heap the wrapper hands out from, which must be inside the arena too. */
extern "C" unsigned char *const g_nfsHeap = nfsArena.heap;
extern "C" const unsigned long g_nfsHeapBytes = (unsigned long)sizeof nfsArena.heap;

/*
 * Where a static lives, as the game now refers to it. Both are compile-time
 * constants, so the several thousand references cost nothing at run time --
 * and, unlike the addresses they replace, they need no relocation, which is
 * what stops the static tables from pinning the executable below 2 GiB.
 */
#define NFS_DATA_AT(field) ((GameAddr32)(offsetof(NfsArena, data) + offsetof(NfsData, field)))
#define NFS_BSS_AT(field) ((GameAddr32)(offsetof(NfsArena, bss) + offsetof(NfsBss, field)))

/* The initial contents of _data, which the game never sees directly. */
static const NfsData nfsDataImage = {'''
    source = source.replace(data_end, arena, 1)

    # Close the image and follow it with the copy-in.
    start = source.index("static const NfsData nfsDataImage = {")
    end = source.index("\n};", start)
    init = '''

/*
 * Puts _data's initial contents where the game will look for them.
 *
 * Called from lowMemInit, which the wrapper runs before anything else, rather
 * than from the game's entry point: the wrapper reads exported statics of its
 * own accord, and a half-initialised _data reads as plausible rubbish instead
 * of failing.
 */
extern "C" void nfsArenaInit(void)
{
\tstatic bool done;
\tif (done)
\t\treturn;
\tdone = true;
\tnfsArena.data = nfsDataImage;
}
'''
    source = source[:end + len("\n};")] + init + source[end + len("\n};"):]
    return source, True


# A generated accessor for a static, e.g.
#   #define dword_401010 ((int8_t *)&_data.dword_401010)
# All 4751 of them have exactly this shape, which is what makes the conversion
# a rewrite rather than a project.
STATIC_MACRO = re.compile(
    r'^#define (\w+) \(\(int8_t \*\)&_(data|bss)\.\1\)$', re.M)


def convert_static_macros(source):
    """Turn the game's static addresses into offsets.

    This is the step the whole exercise is for. Until now a reference to a
    static was its address; now it is its distance from the arena, resolved
    against the base by the six accessors. Nothing else about the generated
    code changes -- the arithmetic the game does on these values (`+ eax * 4`
    and so on) means the same thing either way.

    The type changes from int8_t * to GameAddr32, which is deliberate: any use
    that genuinely wanted a pointer now fails to compile instead of quietly
    truncating. That is the same trick that made narrowing the static tables
    tractable.

    Returns (source, count).
    """
    names = set()

    def rewrite(m):
        name, where = m.group(1), m.group(2)
        names.add(name)
        macro = "NFS_DATA_AT" if where == "data" else "NFS_BSS_AT"
        return f'#define {name} {macro}({name})'

    source, count = STATIC_MACRO.subn(rewrite, source)
    if count:
        source, subscripts = convert_static_subscripts(source, names)
        count = (count, subscripts)
    return source, count


# A static indexed as an array, e.g. `cmp(byte_4E551A[edx], (int8_t)0)`.
# The accessor used to be an int8_t *, so this was a byte load; now the name is
# a number and subscripting it means nothing, which is precisely why the type
# was changed. The compiler finds every one of these.
# Deliberately any identifier, with the accessor names checked against the set
# collected while rewriting them. Guessing the shape of a generated name has
# already gone wrong twice here -- the tables mix dword_4E5010 with FileName
# and _IsTable -- and the set is exact where a pattern is a hope.
SUBSCRIPT = re.compile(r'\b(\w+)\[([^\[\]]+)\]')

# Taking the address of one instead of reading it: `&byte_522390[esi]`, which
# the generated code uses for lea. The answer is the offset, not the host
# address the accessor would resolve it to -- storing the latter in a 32-bit
# slot puts an address where the game expects a distance, and the game then
# resolves it a second time. That is silently survivable while the base is
# small enough that base + base + offset still lands inside the arena, and it
# is a fault the moment the executable is position independent.
SUBSCRIPT_ADDR = re.compile(r'&(\w+)\[([^\[\]]+)\]')
SUBSCRIPT_OFFSET_ADDR = re.compile(
    r'&\((\w+)\s*([+-])\s*([^()\[\]]+)\)\[([^\[\]]+)\]')

# The same thing with the field already displaced, e.g. `(dword_540D94+3)[eax]`,
# which is how the generated code reaches a byte inside a wider field.
SUBSCRIPT_OFFSET = re.compile(
    r'\((\w+)\s*([+-])\s*([^()\[\]]+)\)\[([^\[\]]+)\]')


def convert_static_subscripts(source, names):
    """Rewrite byte-indexing of a static into an offset load.

    `byte_X[edx]` meant the byte edx past _data.X. Said in offsets that is
    to8i(byte_X + edx), which is the same thing and the same lvalue -- these
    appear on both sides of assignments and inside cmp() and test().

    Only after the arena: before it lie the struct declarations, where the
    identical text `name[4]` declares an array rather than indexing one.

    Returns (source, count).
    """
    head, sep, tail = source.partition('extern "C" void nfsArenaInit(void)')
    if not sep:
        raise RuntimeError("arena must be built before subscripts are converted")

    def rewrite_offset(m):
        name, sign, disp, index = m.groups()
        if name not in names:
            return m.group(0)
        return f'to8i({name} {sign} ({disp}) + ({index}))'

    def rewrite(m):
        if m.group(1) not in names:
            return m.group(0)
        return f'to8i({m.group(1)} + ({m.group(2)}))'

    def rewrite_addr_offset(m):
        name, sign, disp, index = m.groups()
        if name not in names:
            return m.group(0)
        return f'({name} {sign} ({disp}) + ({index}))'

    def rewrite_addr(m):
        if m.group(1) not in names:
            return m.group(0)
        return f'({m.group(1)} + ({m.group(2)}))'

    # Address-of forms first, then the displaced read, then the plain one: each
    # later pattern would otherwise match inside what an earlier one handles.
    tail, addr_off = SUBSCRIPT_OFFSET_ADDR.subn(rewrite_addr_offset, tail)
    tail, addr = SUBSCRIPT_ADDR.subn(rewrite_addr, tail)
    tail, displaced = SUBSCRIPT_OFFSET.subn(rewrite_offset, tail)
    tail, plain = SUBSCRIPT.subn(rewrite, tail)
    return head + sep + tail, addr_off + addr + displaced + plain


# A read of the simulated stack that does not go through the accessors, e.g.
#   eax = GetSystemInfo_wrap(*(int32_t *)(esp + 0)); esp += 4;
# The generated code marshals arguments to wrapper calls this way, dereferencing
# esp directly. That was the same thing as to32i(esp + 0) while esp held an
# address; it is a wild pointer once esp holds an offset, and it is the one
# place the claim "every access goes through six helpers" was not true.
RAW_STACK = re.compile(r'\*\((int32_t|float) \*\)\((esp[^()]*)\)')

# The same thing in the x86 string instructions, which walk memory through edi
# and esi: `*(int8_t *)edi = al`.
RAW_STRING_OP = re.compile(r'\*\((int8_t|int16_t|int32_t) \*\)(edi|esi)\b')

# ...and in the thunks the wrapper is called through, which read the game's
# simulated stack from outside the class: `*(int32_t *)(game.esp + 4)`.
RAW_THUNK = re.compile(r'\*\(int32_t \*\)\((game\.esp[^()]*)\)')

WIDTH = {"int8_t": "to8i", "int16_t": "to16i", "int32_t": "to32i", "float": "to32f"}


def convert_raw_access(source):
    """Route every remaining direct dereference through the accessors.

    Three groups reach memory without them, and each was the same thing as the
    accessor while a game address was a real address:

      * the argument marshalling for wrapper calls, `*(int32_t *)(esp + 0)`
      * the x86 string instructions, which walk edi and esi
      * the generated thunks, which read the game's stack as `game.esp + 4`

    Finding them is worth more than the fix: "every access goes through six
    helpers" is what makes this whole change six functions wide, and it was not
    quite true. Anything else of this shape will show up as a wild pointer, so
    the count below is worth watching if the translation is ever regenerated.

    Returns (source, count).
    """
    source, stack = RAW_STACK.subn(
        lambda m: f'{WIDTH[m.group(1)]}({m.group(2)})', source)
    source, string_ops = RAW_STRING_OP.subn(
        lambda m: f'{WIDTH[m.group(1)]}({m.group(2)})', source)
    source, thunks = RAW_THUNK.subn(
        lambda m: f'Game::to32i({m.group(1)})', source)
    return source, stack + string_ops + thunks


# The game context handed to a wrapper function, e.g.
#   eax = fetchTrackRecords((int32_t)this, eax, edx);
CONTEXT_ARG = re.compile(r'\(int32_t\)this\b')

# ...and the declarations those calls go through. Only the first parameter is
# the context; the rest really are 32-bit game values.
CONTEXT_DECL = re.compile(
    r'^extern "C" int32_t (DirectInputCreateA_wrap|DispatchMessageA_wrap|'
    r'fetchTrackRecords|iSNDdirectserve_)\(int32_t arg0', re.M)


def convert_context_pointer(source):
    """Hand the wrapper the game context as a pointer, not as a number.

    Six call sites pass `(int32_t)this`. That was lossless while the context
    lived below 2 GiB, and the wrapper -- whose parameter is `void *this` --
    got the right address back by zero extension. Under base+offset it is not
    an address any more, and the wrapper needs the real one: it uses the
    context to call back into the game.

    So the truncation goes, and the declaration says what it always meant.

    Returns (source, calls, decls).
    """
    source, decls = CONTEXT_DECL.subn(
        lambda m: f'extern "C" int32_t {m.group(1)}(void *arg0', source)
    if not decls:
        return source, 0, 0
    source, calls = CONTEXT_ARG.subn('this', source)
    return source, calls, decls


def swap_window_thread(source):
    """Create the window on the first thread, which is the only one macOS will.

    The game starts its own code and then creates its window from within it.
    That is fine everywhere but macOS, where Cocoa ignores a window created on
    any other thread -- and the wrapper then reports the failure in a message
    box, which is another window, from the same wrong thread, so the process
    hangs there rather than saying anything.

    The translation already has the swapped arrangement behind an ifdef; it had
    simply never been compiled, so it still hands the wrapper a function
    address. It gets an index and the game's context instead, which is what the
    wrapper can call back through.

    This is not a CHANGES entry because build_function_table rewrites the cast
    below into an index, so the applied form cannot be recognised by looking
    for what was written.

    Returns (source, applied).
    """
    # The comment, not the code: build_function_table rewrites the call's
    # argument, and the last two markers chosen from the code went stale the
    # moment the emitted form changed.
    marker = "Not call(): that dispatches through the game's own table"
    if marker in source:
        return source, False

    old = "\tpush32(doStart);\n\tcall(WrapperStartInThread);"
    if old not in source:
        raise RuntimeError("could not find the macOS window-thread entry")

    new = (
        "\t/*\n"
        "\t * Not call(): that dispatches through the game's own table, and this\n"
        "\t * is the wrapper. The game's code goes over as a table index with the\n"
        "\t * context it needs, because an index is what the wrapper can call\n"
        "\t * back through. build_function_table rewrites the cast.\n"
        "\t *\n"
        "\t * And a context of its own, as every other game thread gets: the\n"
        "\t * context is the simulated CPU, so sharing one between two threads\n"
        "\t * shares one esp between them, and they overwrite each other's\n"
        "\t * stack. Never freed; it lives as long as the process.\n"
        "\t */\n"
        "\tGame *game_thread = new (lowMemAlloc(sizeof(Game))) Game();\n"
        "\tWrapperStartInThread(game_thread, (int32_t)doStart);"
    )
    return source.replace(old, new, 1), True


def main():
    check_only = "--check" in sys.argv

    if not os.path.exists(CPP):
        print("src/Cpp/NFS2SE.cpp not found. Run: git submodule update --init --recursive",
              file=sys.stderr)
        return 1

    with open(CPP, encoding="utf-8") as handle:
        source = handle.read()

    applied, already, missing = [], [], []

    for name, old, new in CHANGES:
        if new in source:
            already.append(name)
        elif old in source:
            source = source.replace(old, new, 1)
            applied.append(name)
        else:
            missing.append(name)

    for name in already:
        print(f"  already patched: {name}")
    for name in applied:
        print(f"  patched:         {name}")
    for name in missing:
        print(f"  NOT FOUND:       {name}", file=sys.stderr)

    if missing:
        print("\nsrc/Cpp/NFS2SE.cpp does not look like the expected revision.", file=sys.stderr)
        return 1

    # Ask the state of the file itself rather than looking for a marker string:
    # the WORDSIZE replacement above defines NFS_GA, so its presence says
    # nothing about whether the tables have been narrowed yet.
    source, fields, casts = convert_pointer_fields(source)
    if fields or casts:
        print(f"  patched:         static pointer tables ({fields} fields, {casts} initialisers)")
        applied.append("static pointer tables")
    else:
        print("  already patched: static pointer tables")

    # Must run before the function table, which anchors itself on the last
    # trampoline, and after the tables are narrowed, which locates the _data
    # initialiser by the declaration this rewrites.
    source, swapped = swap_window_thread(source)
    if swapped:
        print("  patched:         macOS window thread")
        applied.append("window thread")
    else:
        print("  already patched: macOS window thread")

    source, arena = build_arena(source)
    if arena:
        print("  patched:         static data into the arena")
        applied.append("arena")
    else:
        print("  already patched: static data into the arena")

    source, macros = convert_static_macros(source)
    if macros:
        print(f"  patched:         static addresses to offsets "
              f"({macros[0]} accessors, {macros[1]} subscripts)")
        applied.append("static offsets")
    else:
        print("  already patched: static addresses to offsets")

    source, raw = convert_raw_access(source)
    if raw:
        print(f"  patched:         direct memory reads through the accessors ({raw} sites)")
        applied.append("raw stack reads")
    else:
        print("  already patched: direct memory reads through the accessors")

    source, calls, decls = convert_context_pointer(source)
    if decls:
        print(f"  patched:         game context as a pointer ({calls} calls, {decls} declarations)")
        applied.append("context pointer")
    else:
        print("  already patched: game context as a pointer")

    # Must run after the tables are narrowed: it rewrites NFS_GA(sub_X), which
    # only exists once those initialisers have been converted.
    source, functions = build_function_table(source)
    if functions:
        print(f"  patched:         function dispatch table ({functions} functions)")
        applied.append("function dispatch table")
    else:
        print("  already patched: function dispatch table")

    if check_only:
        print("\nUp to date." if not applied else "\nWould apply the changes above.")
        return 0

    if applied:
        with open(CPP, "w", encoding="utf-8") as handle:
            handle.write(source)
        print("\nWrote src/Cpp/NFS2SE.cpp.")
    else:
        print("\nNothing to do.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
