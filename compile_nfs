#!/usr/bin/env bash

BUILD="x86"
BUILD_TYPE="release"
BUILD_64="no"
CPP_EXTRA=""
CC=${CC:-gcc}
CXX=${CXX:-g++}
BUILD_WINDOWS="no"
OPENGL_DEFINE=""
OPENGL_LIBS="-lGL"
# Graphics libraries per platform. Overridden below when a backend needs
# something other than OpenGL.
WIN_GFX_LIBS="-lopengl32"
MAC_GFX_LIBS="-framework OpenGL"
MAC_GFX_FLAGS="-I/opt/homebrew/include -I/usr/local/include"
ANDROID_INSTALL="no"
# Overridable: CPP_LTO= isolates whether a fault is the optimiser or the
# link-time one, which is a distinction worth being able to make in one run.
CPP_LTO=${CPP_LTO-"-flto"}

OS=$(uname)

function compile_x86
{
	CPU_FLAGS='-mno-sse2 -mno-sse -mno-mmx'
	COMMON_FLAGS='-Wall -m32 -std=gnu89'

	echo -n "Building"
	if [[ $BUILD_TYPE == "debug" ]]; then
		echo -n " debug"
		WIN_SUBSYSTEM='console'
		DEBUG_ASM='-g dwarf2'
		C_FLAGS="$COMMON_FLAGS -g $CPU_FLAGS"
	else
		echo -n " release"
		WIN_SUBSYSTEM='windows'
		C_FLAGS="$COMMON_FLAGS -O2 $CPU_FLAGS"
		STRIP='-s'
	fi

	rm -f *.o

	echo -n " for"
	if [[ $BUILD_WINDOWS == "yes" ]]; then
		echo -n " Windows... "
		i686-w64-mingw32-windres Windows/nfs2se.rc icon.o &&
		i686-w64-mingw32-gcc $C_FLAGS $OPENGL_DEFINE -c *.c &&
		yasm -f win32 Asm/NFS2SE.asm -o NFS2SE.Win32.o $DEBUG_ASM --prefix=_ &&
		i686-w64-mingw32-ld --enable-stdcall-fixup -o "../Need For Speed II SE/nfs2se.exe" *.o --stack=0x7D00,0x7D00 --heap=0x2000,0x1000 -lws2_32 -lwinmm -lmingwex -lmsvcrt -lkernel32 $WIN_GFX_LIBS -lSDL2 -subsystem=$WIN_SUBSYSTEM $STRIP -e _start &&
		rm -f *.o &&
		echo "OK!"
	else
		if [ $OS == "Darwin" ]; then
			echo -n " macOS... "
			clang $C_FLAGS $MAC_GFX_FLAGS $OPENGL_DEFINE -DSTACK_REALIGN -DSWAP_WINDOW_AND_GL_THREAD -c *.c -mmacosx-version-min=10.6 &&
			yasm -f macho Asm/NFS2SE.asm -o NFS2SE.OSX.o --prefix=_ -DSWAP_WINDOW_AND_GL_THREAD &&
			ld -o "../Need For Speed II SE/nfs2se" *.o -lc -lSDL2 $MAC_GFX_LIBS -macosx_version_min 10.6 -e _start &&
			rm -f *.o &&
			echo "OK!"
		else
			if [ -z $CC ]; then
				CC=gcc
			fi
			echo -n " $OS ($CC)... "
			yasm -f elf32 Asm/NFS2SE.asm -o NFS2SE.Elf32.o $DEBUG_ASM &&
			$CC -no-pie -nostartfiles $C_FLAGS -DSTACK_REALIGN $OPENGL_DEFINE -o "../Need For Speed II SE/nfs2se" NFS2SE.Elf32.o *.c -lSDL2 $OPENGL_LIBS $STRIP -Wl,-rpath=\$ORIGIN -Wl,-estart &&
			rm -f NFS2SE.Elf32.o &&
			echo "OK!"
		fi
	fi
}

function compile_cpp
{
	#
	# Both word sizes need the patch, and for the same reason: it is what
	# defines the dispatch table the wrapper calls the game back through, and
	# what turns the game's addresses into offsets. A 32-bit build that skipped
	# it did not merely run an older model -- it failed to link, because
	# nfsCallGameFunction had no definition. See tools/patch_cpp_64bit.
	#
	echo -n "Patching the translated game... "
	python3 ../tools/patch_cpp_64bit > /dev/null || exit
	echo "OK!"

	if [[ $BUILD_64 == "yes" ]]; then
		#
		# Position independent, which the old model could not be: it needed
		# code and static data below 2 GiB, and a PIE is loaded far above that.
		# Nothing needs a particular address now -- the game addresses its
		# world by offset -- and that matters beyond tidiness: arm64 macOS
		# ignores -no_pie outright, so a build that required it could never
		# have run there.
		#
		# -fpermissive downgrades the "cast loses precision" errors that the
		# 32-bit slots produce by design on a 64-bit host. They are the
		# intended behaviour, not oversights.
		#
		CPP_EXTRA="-fpermissive -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast"
	elif [ $(uname -m) == "x86_64" ]; then
		CPU_FLAGS="-m32"
	fi

	if [[ $BUILD_TYPE == "debug" ]]; then
		FLAGS="-O0 -g -fno-strict-aliasing"
		CPP_LTO=""
		echo "Debug"
	else
		FLAGS="-O3 -DNDEBUG -fno-strict-aliasing"
		echo "Release"
	fi

	# Same passthrough as tools/rebuild_wrapper, so that a fault which only
	# appears in a release build can still be looked at: NFS_CPP_FLAGS="-O1 -g"
	# bisects the optimiser, and any -g here keeps the symbols that strip would
	# otherwise take away exactly when they are wanted.
	FLAGS="$FLAGS ${NFS_CPP_FLAGS:-}"

	# Homebrew is not on the default search path, and on macOS the Vulkan
	# loader, MoltenVK and SDL2 all live there. compile_x86 already did this;
	# the C++ path needs it too now that it is a macOS target at all.
	if [ $OS == "Darwin" ]; then
		CPU_FLAGS="$CPU_FLAGS $MAC_GFX_FLAGS"
		MAC_LIB_PATHS="-L/opt/homebrew/lib -L/usr/local/lib"
		#
		# Cocoa creates windows on the first thread or not at all, and the game
		# creates its own from a thread. Both the wrapper and the translation
		# implement the swap; only the assembly build ever asked for it.
		#
		CPP_EXTRA="$CPP_EXTRA -DSWAP_WINDOW_AND_GL_THREAD"
		MAC_C_DEFINES="-DSWAP_WINDOW_AND_GL_THREAD"
	fi

	echo -n "Compiling C++ code... "
	# Both spellings of the same suppression: -Wno-c++11-narrowing is clang's,
	# -Wno-narrowing is GCC's, and each silently ignores the other's. The
	# translated data tables initialise int32_t fields with values like
	# 0xFFFFFFF6, so without the right one for the compiler in hand this is an
	# error rather than a warning. The 64-bit build only ever got away with it
	# because -fpermissive happens to downgrade it too.
	$CXX -c -std=c++14 $CPU_FLAGS $CPP_LTO $FLAGS $CPP_EXTRA -Wno-c++11-narrowing -Wno-narrowing -Wextra Cpp/NFS2SE.cpp -fno-rtti -fno-exceptions || exit
	echo "OK!"

	echo -n "Compiling C code... "
	$CC -c -std=gnu89 -Wno-incompatible-function-pointer-types -Wno-int-conversion -Wall $CPU_FLAGS $FLAGS $OPENGL_DEFINE $MAC_C_DEFINES -DNFS_CPP *.c || exit
	echo "OK!"

	echo -n "Linking... "
	$CXX -o "../Need For Speed II SE/nfs2se" $CPU_FLAGS $CPP_LTO *.o $MAC_LIB_PATHS -lSDL2 $OPENGL_LIBS -lm -lpthread || exit
	echo "OK!"

	if [[ $BUILD_TYPE != "debug" && "$FLAGS" != *-g* ]]; then
		echo -n "Stripping... "
		strip "../Need For Speed II SE/nfs2se" || exit
		echo "OK!"
	fi

	rm -f *.o
}

while (( $# > 0 ))
do
	key=$1
	case $key in
		cpp|android)
			BUILD=$key
		;;
		cpp64)
			BUILD="cpp"
			BUILD_64="yes"
		;;
		debug)
			BUILD_TYPE="debug"
		;;
		win32)
			BUILD_WINDOWS="yes"
		;;
		gl1)
			OPENGL_DEFINE="-DOPENGL1X"
		;;
		gles2)
			OPENGL_DEFINE="-DGLES2"
			OPENGL_LIBS="-lGLESv2"
		;;
		vulkan)
			OPENGL_DEFINE="-DVULKAN"
			OPENGL_LIBS="-lvulkan"
			WIN_GFX_LIBS="-lvulkan-1"
			# On macOS the loader dispatches to MoltenVK. Note that a 32-bit
			# build cannot run here anyway (macOS dropped 32-bit in Catalina);
			# this path exists for a future 64-bit port and for tools/build_replay.
			MAC_GFX_LIBS="-lvulkan"
			MAC_GFX_FLAGS="-I/opt/homebrew/include -I/usr/local/include"
		;;
		install)
			ANDROID_INSTALL="yes"
		;;
	esac
	shift
done

cd src || exit

if [[ $BUILD != "android" ]]; then
	if [[ $OPENGL_DEFINE == "-DVULKAN" ]]; then
		echo "Building Vulkan"
	elif [[ $OPENGL_DEFINE == "-DOPENGL1X" ]]; then
		echo "Building OpenGL 1"
	elif [[ $OPENGL_DEFINE == "-DGLES2" ]]; then
		if [[ $OS == "Darwin" ]]; then
			echo "OpenGL|ES 2 is not supported on macOS"
			exit 1
		fi
		if [[ $BUILD_WINDOWS == "yes" ]]; then
			echo "OpenGL|ES 2 is not supported on Windows"
			exit 1
		fi
		echo "Building OpenGL|ES 2"
	else
		echo "Building OpenGL 2"
	fi
fi

if [[ $BUILD == "cpp" ]]; then
	if [[ $OS == "Darwin" ]] && [[ $BUILD_64 != "yes" ]]; then
		echo "The 32-bit C++ translation cannot run on macOS (no 32-bit support since Catalina)."
		echo "Use 'cpp64' instead."
		exit 1
	fi
	if [[ $BUILD_WINDOWS == "yes" ]]; then
		echo "C++ translation is not supported on Windows"
		exit 1
	fi
	compile_cpp $@
elif [[ $BUILD == "android" ]]; then
	VERSION=$(grep WRAPPER_VERSION "Version" | cut -c26-30 | grep "\.") || exit
	cd Android || exit
	echo "Building OpenGL|ES 2 for Android, wrapper version: $VERSION"
	sed "s/@VERSION@/$VERSION/" app/src/main/AndroidManifest.xml.in > app/src/main/AndroidManifest.xml || exit
	rm -f app/build/outputs/apk/debug/app-debug.apk || exit
	./gradlew packageDebug || exit # packageRelease if you want to sign it
	if [[ $ANDROID_INSTALL == "yes" ]]; then
		adb install -r app/build/outputs/apk/debug/app-debug.apk || exit
		sleep 0.25
		adb shell am start -n org.zaps166.NFSIISE/org.zaps166.NFSIISE.NFSIISE
	fi
else
	compile_x86 $@
fi
